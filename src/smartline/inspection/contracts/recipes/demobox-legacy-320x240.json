{
  "name": "DemoBox",
  "description": "First end-to-end recipe for colored boxes. It exercises the pipeline and is not a permanent product catalog.",
  "productClasses": [
    { "code": "BOX_RED", "displayName": "Red box", "expectedColor": "RED" },
    { "code": "BOX_BLUE", "displayName": "Blue box", "expectedColor": "BLUE" },
    { "code": "BOX_GREEN", "displayName": "Green box", "expectedColor": "GREEN" }
  ],
  "allowedColors": [
    { "code": "RED", "displayName": "Red", "hueMin": 345, "hueMax": 15, "saturationMin": 0.25, "valueMin": 0.2 },
    { "code": "BLUE", "displayName": "Blue", "hueMin": 190, "hueMax": 250, "saturationMin": 0.25, "valueMin": 0.2 },
    { "code": "GREEN", "displayName": "Green", "hueMin": 80, "hueMax": 160, "saturationMin": 0.25, "valueMin": 0.2 }
  ],
  "sizeClasses": [
    { "code": "SMALL", "displayName": "Small", "minWidthMm": 0, "maxWidthMm": 40 },
    { "code": "MEDIUM", "displayName": "Medium", "minWidthMm": 40, "maxWidthMm": 80 },
    { "code": "LARGE", "displayName": "Large", "minWidthMm": 80, "maxWidthMm": 200 }
  ],
  "defectClasses": [
    { "code": "WRONG_COLOR", "displayName": "Wrong color", "rejects": true },
    { "code": "WRONG_SIZE", "displayName": "Wrong size", "rejects": true },
    { "code": "DAMAGED", "displayName": "Damaged", "rejects": true },
    { "code": "MISSING_LABEL", "displayName": "Missing label", "rejects": true },
    { "code": "WRONG_ORIENTATION", "displayName": "Wrong orientation", "rejects": true }
  ],
  "acceptance": {
    "minimumConfidence": 0.6,
    "rejectUnknownClass": true,
    "rejectUnknownDefects": true,
    "defectsOverrideLowConfidence": true,
    "requireKnownColor": false,
    "defaultDestinationBin": "MANUAL_REVIEW"
  },
  "sortingRules": [
    { "id": "any-defect", "priority": 10, "when": { "quality": "DEFECTIVE" }, "destinationBin": "REJECT_BIN" },
    { "id": "red-large", "priority": 20, "when": { "quality": "GOOD", "colorClass": "RED", "sizeClass": "LARGE" }, "destinationBin": "BIN_A" },
    { "id": "blue-medium", "priority": 30, "when": { "quality": "GOOD", "colorClass": "BLUE", "sizeClass": "MEDIUM" }, "destinationBin": "BIN_B" },
    { "id": "green-good", "priority": 40, "when": { "quality": "GOOD", "productClass": "BOX_GREEN" }, "destinationBin": "BIN_C" }
  ],
  "destinationBins": [
    { "code": "BIN_A", "displayName": "Bin A", "role": "PASS" },
    { "code": "BIN_B", "displayName": "Bin B", "role": "PASS" },
    { "code": "BIN_C", "displayName": "Bin C", "role": "PASS" },
    { "code": "REJECT_BIN", "displayName": "Reject", "role": "REJECT" },
    { "code": "MANUAL_REVIEW", "displayName": "Manual review", "role": "HOLD" }
  ],
  "model": {
    "task": "detect",
    "family": "YOLO26",
    "name": "yolo26n",
    "version": "untrained",
    "artifactFileName": null,
    "inputSize": 640
  },
  "cameraProfile": {
    "streamUrl": "http://192.168.1.50:81/stream",
    "sourceWidth": 320,
    "sourceHeight": 240,
    "sensor": "GC2145",
    "pixelFormat": "RGB565",
    "transport": "MJPEG",
    "notes": "Live preview may stay at a low resolution. Inspection selects one frame when a product arrives."
  },
  "roi": { "x": 0.1, "y": 0.1, "width": 0.8, "height": 0.8 },
  "calibrationProfileId": null,
  "physicalLimits": {
    "maxWidthMm": 250,
    "maxHeightMm": 250,
    "minConfidenceToSort": 0.6
  },
  "inspection": {
    "triggerModes": ["manual", "api", "simulator", "hardware"],
    "selectionStrategy": "latest_frame_on_trigger",
    "continuousInference": false
  }
}
