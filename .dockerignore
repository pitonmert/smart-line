# The API image builds both the backend and Dashboard. Only approved source files
# enter the build context; secrets, local settings and build outputs stay outside.
**

!.dockerignore
!SmartLine.API/
!SmartLine.API/Program.cs
!SmartLine.API/SmartLine.API.csproj
!SmartLine.API/Dockerfile
!SmartLine.API/docker-entrypoint.sh
!SmartLine.API/appsettings.json
!SmartLine.API/appsettings.Development.json
!SmartLine.API/Contracts/
!SmartLine.API/Contracts/**
!SmartLine.API/Domain/
!SmartLine.API/Domain/**
!SmartLine.API/Features/
!SmartLine.API/Features/**
!SmartLine.API/Infrastructure/
!SmartLine.API/Infrastructure/**
!SmartLine.API/Migrations/
!SmartLine.API/Migrations/**
!SmartLine.API/Shared/
!SmartLine.API/Shared/**

!SmartLine.Dashboard/
!SmartLine.Dashboard/package.json
!SmartLine.Dashboard/package-lock.json
!SmartLine.Dashboard/index.html
!SmartLine.Dashboard/eslint.config.js
!SmartLine.Dashboard/tsconfig.app.json
!SmartLine.Dashboard/tsconfig.json
!SmartLine.Dashboard/tsconfig.node.json
!SmartLine.Dashboard/vite.config.ts
!SmartLine.Dashboard/dev/
!SmartLine.Dashboard/dev/mock-server.ts
!SmartLine.Dashboard/public/
!SmartLine.Dashboard/public/**
!SmartLine.Dashboard/src/
!SmartLine.Dashboard/src/**

# Keep local artifacts and credentials excluded even inside approved directories.
**/bin
**/obj
**/node_modules
**/dist
**/logs
**/.git
**/.env*
**/*.user
**/*.key
**/*.pfx
**/*.p12
SmartLine.API/appsettings.*.json
!SmartLine.API/appsettings.Development.json
