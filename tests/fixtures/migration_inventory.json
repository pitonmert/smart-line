    "UntouchedLegacyDemoBoxCameraProfileIsCorrected": "Not applicable to clean cutover; the current corrected contract is seeded directly.",
    "CustomizedDemoBoxKeepsItsCameraProfile": "No legacy records are imported or mutated; pre-existing databases remain untouched.",
    "OlderInspectionAndDatasetRowsKeepTheirDefaults": "No old database rows are imported; new model defaults and legacy PNG reads are covered in test_api.py."
  }
