# PostgreSQL
POSTGRES_DB=smartline_python
POSTGRES_USER=smartline
POSTGRES_PASSWORD=replace-with-a-long-random-password

# MQTT principals (second factor alongside local-CA client certificates)
MQTT_API_PASSWORD=replace-with-a-long-random-password
MQTT_FIRMWARE_PASSWORD=replace-with-a-long-random-password
MQTT_VISION_PASSWORD=replace-with-a-long-random-password
# Optional absolute certificate directory; Compose defaults to deploy/certs/generated.
# SMARTLINE_CERT_DIR=/absolute/path/to/certificates

# Physical camera stream. Vision derives http://<host>/capture from this URL.
CAM_STREAM_URL=http://192.168.1.50:81/stream
# Optional override when the still endpoint is not /capture on the stream host.
# CAM_CAPTURE_URL=

VISION_CAPTURE_TIMEOUT_SECONDS=35
STILL_CAPTURE_TIMEOUT=30
# Path inside the read-only deploy/models mount; restart Vision after changing it.
MODEL_PATH=
MODEL_VERSION=

# Python web/system process (local commands). Production Compose supplies these from POSTGRES_* and MQTT_* above.
DATABASE_URL=postgresql://smartline:replace-with-a-long-random-password@127.0.0.1:5432/smartline_python
DATASET_ROOT=data/python/datasets
VISION_URL=http://127.0.0.1:8090
SMARTLINE_ENV=development
# Set true only when MQTT certificates and broker are configured for local development.
MQTT_ENABLED=false
