{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TimeZone": {
    "Id": "Europe/Istanbul"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Mqtt": {
    "BrokerAddress": "localhost",
    "Port": 8883,
    "ClientId": "smartline-api",
    "Username": "",
    "Password": "",
    "CaCertificatePath": "",
    "ClientCertificatePath": "",
    "ClientKeyPath": "",
    "Topics": {
      "Environment": "smartline/sensors/environment",
      "Barcode": "smartline/sensors/barcode",
      "Fire": "smartline/sensors/fire",
      "CommandSpeed": "smartline/commands/speed",
      "CommandStop": "smartline/commands/stop",
      "CommandFan": "smartline/commands/fan"
    }
  },
  "EnvironmentThresholds": {
    "HighTempThreshold": 35,
    "AlarmTempThreshold": 40,
    "FanHysteresisCelsius": 2
  },
  "Jwt": {
    "Issuer": "SmartLine.API",
    "Audience": "SmartLine.Dashboard",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "DeviceAuthentication": {
    "Key": ""
  },
  "BootstrapAdmin": {
    "Email": "",
    "Password": ""
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  }
}
