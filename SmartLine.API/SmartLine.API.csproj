<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b3ffb8ed-b170-4d39-8fc6-92e02d38db45</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="Contracts\recipes\demobox-legacy-320x240.json"
      LogicalName="SmartLine.API.Contracts.recipes.demobox-legacy-320x240.json"
    />
    <EmbeddedResource
      Include="Contracts\calibration\uncalibrated.json"
      LogicalName="SmartLine.API.Contracts.calibration.uncalibrated.json"
    />
    <EmbeddedResource Include="Contracts\recipes\demobox.json">
      <LogicalName>SmartLine.API.Contracts.recipes.demobox.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Contracts\fixtures\decision-cases.json">
      <LogicalName>SmartLine.API.Contracts.fixtures.decision-cases.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="5.1.0.1559" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
